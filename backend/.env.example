# Canonical local configuration template. Existing .env files are not updated automatically.

# Core application
APP_NAME=Career Agent API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./career_agent.db
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Semantic LLM provider. OpenAI requires OPENAI_API_KEY; Ollama requires a reachable local endpoint and installed model.
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# Semantic operation models. Provider-neutral names take precedence over legacy OPENAI_*_MODEL settings.
CV_SEMANTIC_EXTRACTION_MODEL=gpt-5.6-luna
JOB_EXTRACTION_MODEL=gpt-5.6-luna
REQUIREMENT_MATCHING_MODEL=gpt-5.6-luna
CAREER_ALIGNMENT_MODEL=gpt-5.6-luna
JOB_RELEVANCE_MODEL=gpt-5.6-luna
JOB_ARCHETYPE_MODEL=gpt-5.6-luna
AGENTIC_DISCOVERY_MODEL=gpt-5.6-luna

# Search provider
AGENTIC_SEARCH_PROVIDER=openai
OPENAI_WEB_SEARCH_MODEL=gpt-5.6-luna
BRAVE_SEARCH_API_KEY=

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=career-trans-dev

# Structured ATS sources (optional)
GREENHOUSE_BOARD_TOKENS=
ASHBY_BOARD_TOKENS=
LEVER_SITE_TOKENS=
SMARTRECRUITERS_COMPANY_IDS=
RECRUITEE_COMPANY_TOKENS=
