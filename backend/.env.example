# Canonical local configuration template. Existing .env files are not updated automatically.

# Core application
APP_NAME=Career Agent API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./career_agent.db
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Semantic LLM provider. OpenAI requires OPENAI_API_KEY; Ollama requires a reachable local endpoint and installed model.
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# Semantic operation models. Provider-neutral names take precedence over legacy OPENAI_*_MODEL settings.
CV_SEMANTIC_EXTRACTION_MODEL=gpt-5.6-luna
CANDIDATE_ADVISER_MODEL=gpt-5.6-luna
JOB_EXTRACTION_MODEL=gpt-5.6-luna
REQUIREMENT_MATCHING_MODEL=gpt-5.6-luna
CAREER_ALIGNMENT_MODEL=gpt-5.6-luna
JOB_RELEVANCE_MODEL=gpt-5.6-luna
JOB_ARCHETYPE_MODEL=gpt-5.6-luna
AGENTIC_DISCOVERY_MODEL=gpt-5.6-luna
APPLICATION_DRAFTING_MODEL=gpt-5.6-luna

# Host-side local Codex discovery model. Independent from Career-trans semantic/API models
# and from the global Codex coding model in the user's Codex configuration.
CODEX_EXTERNAL_DISCOVERY_MODEL=gpt-5.6-luna

# Optional reasoning effort per logical semantic operation. Blank preserves
# provider-default behavior and omits the OpenAI reasoning request parameter.
CV_SEMANTIC_EXTRACTION_REASONING_EFFORT=
CANDIDATE_ADVISER_REASONING_EFFORT=
JOB_EXTRACTION_REASONING_EFFORT=
REQUIREMENT_MATCHING_REASONING_EFFORT=
CAREER_ALIGNMENT_REASONING_EFFORT=
JOB_RELEVANCE_REASONING_EFFORT=
JOB_ARCHETYPE_REASONING_EFFORT=
AGENTIC_DISCOVERY_REASONING_EFFORT=
APPLICATION_DRAFTING_REASONING_EFFORT=

# Search provider
# Disabled by default: set to openai or brave only when intentionally enabling in-process web search.
AGENTIC_SEARCH_PROVIDER=disabled
OPENAI_WEB_SEARCH_MODEL=gpt-5.6-luna
BRAVE_SEARCH_API_KEY=

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=career-trans-dev

# Structured ATS sources (optional)
GREENHOUSE_BOARD_TOKENS=
ASHBY_BOARD_TOKENS=
LEVER_SITE_TOKENS=
SMARTRECRUITERS_COMPANY_IDS=
RECRUITEE_COMPANY_TOKENS=
