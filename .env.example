# Optional Docker Compose configuration for local development.
# Copy to a root-level .env only when you want to override these defaults.
# docker compose up --build works without this file.
#
# This file is for Compose interpolation, not the native backend/.env file.
# Provider values are passed only to the backend container and never to the
# frontend build or browser bundle.
# LangSmith tracing is opt-in. After changing root .env, recreate the backend
# container; see docs/langsmith-tracing.md for safe verification steps.

BACKEND_PORT=8000
FRONTEND_PORT=5173
JWT_SECRET_KEY=replace-with-a-local-development-secret
DEFAULT_LLM_PROVIDER=openai
SEMANTIC_CREDENTIAL_POLICY=user_or_deployment
# Separate URL-safe base64 32-byte AES-GCM key. Keep private; never reuse TAVILY's key.
SEMANTIC_CREDENTIAL_ENCRYPTION_KEY=
AGENTIC_SEARCH_PROVIDER=disabled
LOCAL_CODEX_DISCOVERY_ENABLED=false
LOCAL_CODEX_SEARCH_MODEL=gpt-5.6-luna
LOCAL_CODEX_SCHEDULED_DISCOVERY_CAPABILITY=unverified
LANGSMITH_TRACING=false
# Local trace project. Change it to the exact project you want to inspect.
LANGSMITH_PROJECT=career-trans-dev
# US SaaS default; set https://eu.api.smith.langchain.com for EU workspaces.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Deployment-owned semantic model defaults (also forwarded to the backend in Compose).
CV_SEMANTIC_EXTRACTION_MODEL=gpt-5.6-luna
CANDIDATE_ADVISER_MODEL=gpt-5.6-luna
JOB_EXTRACTION_MODEL=gpt-5.6-luna
REQUIREMENT_MATCHING_MODEL=gpt-5.6-luna
CAREER_ALIGNMENT_MODEL=gpt-5.6-luna
JOB_RELEVANCE_MODEL=gpt-5.6-luna
JOB_ARCHETYPE_MODEL=gpt-5.6-luna
AGENTIC_DISCOVERY_MODEL=gpt-5.6-luna
APPLICATION_DRAFTING_MODEL=gpt-5.6-luna

# Optional effort values: none, low, medium, high, xhigh, max. Blank inherits provider default.
CV_SEMANTIC_EXTRACTION_REASONING_EFFORT=
CANDIDATE_ADVISER_REASONING_EFFORT=
JOB_EXTRACTION_REASONING_EFFORT=
REQUIREMENT_MATCHING_REASONING_EFFORT=
CAREER_ALIGNMENT_REASONING_EFFORT=
JOB_RELEVANCE_REASONING_EFFORT=
JOB_ARCHETYPE_REASONING_EFFORT=
AGENTIC_DISCOVERY_REASONING_EFFORT=
APPLICATION_DRAFTING_REASONING_EFFORT=

# Optional backend-only provider configuration. Leave blank for credential-free
# startup; provider-backed actions then fail safely when invoked.
OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Optional; set this separately to enable encrypted user-saved Tavily API keys.
TAVILY_CREDENTIAL_ENCRYPTION_KEY=
LANGSMITH_API_KEY=
# Required only for organization-scoped LangSmith API keys; never commit a real ID.
LANGSMITH_WORKSPACE_ID=
